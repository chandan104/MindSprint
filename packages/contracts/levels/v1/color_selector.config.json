{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindsprint/levels/v1/color_selector.config.json",
  "title": "Colour Selector (selective attention) level config v1",
  "description": "Each round shows an instruction, then a grid of colour options. Stroop levels print colour words in mismatched ink and ask for the WORD or the INK.",
  "type": "object",
  "required": ["colour_count", "time_limit_ms_per_round"],
  "properties": {
    "colour_count": { "type": "integer", "minimum": 2, "maximum": 6 },
    "time_limit_ms_per_round": { "type": "integer", "minimum": 1500, "maximum": 30000 },
    "stroop": { "type": "boolean" },
    "instruction_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["colour", "word"] }
    }
  },
  "additionalProperties": false
}
